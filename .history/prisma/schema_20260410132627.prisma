// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- USER & AUTH ---

enum Role {
  ADMIN
  SALES_AGENT
  COACH
  NUTRITIONIST
  CLIENT
}

enum ServiceType {
  PERSONAL_TRAINING
  MASSAGE
  NUTRITIONIST
  GYM_CLASS
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
}

enum ApptStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NOSHOW
}

model Profile{
  id  String  @id @default(uuid())
  email String @unique
  fullName String
  role Role @default(CLIENT)
  phoneNumber String?
  createdAt DateTime @default(now())

  // Relationships 
  subscriptions       Subscription[]
  orders              Order[]
  accessCodes         AccessCode[]
  bookings            Booking[]       @relation("ClientBookings")
  coachSchedules      Schedule[]      @relation("CoachSchedules")
  clientAppointments  Appointment[]   @relation("ClientAppointments")
  coachAppointments   Appointment[]   @relation("CoachAppointments")
}

// --- GYM & COACHES ---

model Activity{
  id String @id @default(cuid())
  name String
  description String?
  schedules Schedule[]
}

model Schedule{
  id String @id @default(cuid())
  activityId String 
  activity Activity @relation(fields: [activityId], references: [id])
  coachId String
  coach       Profile   @relation("CoachSchedules", fields: [coachId], references: [id])
  startTime DateTime
  endTime DateTime
  capacity Int @default(20)
  bookings Booking[]
}

model Booking {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  clientId   String
  client     Profile  @relation("ClientBookings", fields: [clientId], references: [id])
  createdAt  DateTime @default(now())
}

// --- LAYER 1: GENERAL ACCESS (Subscriptions) ---

model Subscription {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  type      String   // e.g., "DAILY_PASS", "MONTHLY_GYM"
  status    String   @default('')
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// --- LAYER 2: SPECIALIZED SERVICES (Personal Trainers/Massages) ---

model Appointment {
  id            String        @id @default(cuid())
  clientId      String
  client        Profile       @relation("ClientAppointments", fields: [clientId], references: [id])
  coachId       String
  coach         Profile       @relation("CoachAppointments", fields: [coachId], references: [id])
  serviceType   ServiceType
  scheduledAt   DateTime
  duration      Int           @default(60)
  paymentStatus PaymentStatus @default(PENDING)
  price         Decimal       @db.Decimal(10, 2)
  status        ApptStatus    @default(SCHEDULED)
}

model AccessCode {
  id        String   @id @default(cuid())
  code      String   @unique // The 6-digit code for the agent to check
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  expiresAt DateTime
  isUsed    Boolean  @default(false)
}

// --- E-COMMERCE ---

model Product {
  id          String      @id @default(cuid())
  name        String
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  image       String?     // URL from Supabase Storage
  orderItems  OrderItem[]
}

model Order {
  id          String      @id @default(cuid())
  profileId   String
  profile     Profile     @relation(fields: [profileId], references: [id])
  total       Decimal     @db.Decimal(10, 2)
  status      String      @default("PENDING") // PENDING, PAID, DELIVERED
  address     String?     // For delivery
  items       OrderItem[]
  createdAt   DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
}
