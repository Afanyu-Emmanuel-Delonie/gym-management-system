// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- USER & AUTH ---

enum Role {
  ADMIN
  SALES_AGENT
  COACH
  NUTRITIONIST
  CLIENT
}

enum ServiceType {
  PERSONAL_TRAINING
  MASSAGE
  NUTRITIONIST
  GYM_CLASS
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
}

enum ApptStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NOSHOW
}

model Profile{
  id  String  @id @default(uuid())
  email String @unique
  fullName String
  role Role @default(CLIENT)
  phoneNumber String?
  createdAt DateTime @default(now())

  // Relationships 
  subscriptions       Subscription[]
  orders              Order[]             @relation("ClientOrders")
  accessCodes         AccessCode[]
  coachSchedules      Schedule[]      @relation("CoachSchedules")
  bookings            Booking[]       @relation("ClientBookings")
  clientAppointments  Appointment[]   @relation("ClientAppointments")
  coachAppointments   Appointment[]   @relation("CoachAppointments")
  testimonials        Testimonial[]
}

// --- GYM & COACHES ---

model Activity{
  id String @id @default(cuid())
  name String
  description String?
  schedules Schedule[]
}

model Schedule{
  id String @id @default(cuid())
  activityId String 
  activity Activity @relation(fields: [activityId], references: [id])
  coachId String
  coach       Profile   @relation("CoachSchedules", fields: [coachId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime DateTime
  capacity Int @default(20)
  bookings Booking[]
}

model Booking {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  clientId   String
  client     Profile  @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// --- LAYER 1: GENERAL ACCESS (Subscriptions) ---

enum SubscriptionType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id         String             @id @default(cuid())
  profileId  String
  profile    Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type       SubscriptionType
  status     SubscriptionStatus @default(PENDING)
  accessCode String?            @unique // Generated once on activation
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime           @default(now())
}

// --- LAYER 2: SPECIALIZED SERVICES (Personal Trainers/Massages) ---

model Appointment {
  id            String        @id @default(cuid())
  clientId      String
  client        Profile       @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  coachId       String
  coach         Profile       @relation("CoachAppointments", fields: [coachId], references: [id], onDelete: Cascade)
  serviceType   ServiceType
  scheduledAt   DateTime
  duration      Int           @default(60)
  paymentStatus PaymentStatus @default(PENDING)
  price         Decimal       @db.Decimal(10, 2)
  status        ApptStatus    @default(SCHEDULED)
}

model AccessCode {
  id        String   @id @default(cuid())
  code      String   @unique // The 6-digit code for the agent to check
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
}

// --- UTILITIES ---

model GymService {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String?  // icon name or URL
  image       String?
  price       Decimal? @db.Decimal(10, 2) // null = price on request
  isActive    Boolean  @default(true)
  order       Int      @default(0) // display order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content     String
  rating      Int      // 1-5
  isApproved  Boolean  @default(false) // admin must approve before showing
  createdAt   DateTime @default(now())
}

// --- E-COMMERCE ---

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum DeliveryType {
  PICKUP
  DELIVERY
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Discount {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType
  value       Decimal      @db.Decimal(10, 2) // e.g. 10 = 10% or 10 RWF off
  minOrder    Decimal?     @db.Decimal(10, 2) // minimum order amount to apply
  maxUses     Int?         // null = unlimited
  usedCount   Int          @default(0)
  isActive    Boolean      @default(true)
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  orders      Order[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  category    String
  image       String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id              String       @id @default(cuid())
  clientId        String
  client          Profile      @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Cascade)
  totalAmount     Decimal      @db.Decimal(10, 2)
  discountAmount  Decimal      @db.Decimal(10, 2) @default(0)
  finalAmount     Decimal      @db.Decimal(10, 2)
  status          OrderStatus  @default(PENDING)
  deliveryType    DeliveryType @default(PICKUP)
  deliveryAddress String?
  discountId      String?
  discount        Discount?    @relation(fields: [discountId], references: [id])
  delivery        Delivery?
  items           OrderItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
}

model Delivery {
  id             String   @id @default(cuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  address        String
  trackingNote   String?
  estimatedAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
